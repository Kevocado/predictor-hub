# Copy to /opt/stack/.env on the VPS (chmod 600). Never commit the real file.

# ── Hosting ──────────────────────────────────────────────────────────────
# Your domain. Sites become pl.$DOMAIN, f1.$DOMAIN, nba.$DOMAIN, sports.$DOMAIN.
# No domain yet? Use <vps-ip-with-dashes>.sslip.io (e.g. 203-0-113-7.sslip.io)
# to test, but switch to a real domain before going live.
DOMAIN=example.com

# ── Image tags (bin/deploy rewrites these; leave as latest to start) ─────
PL_TAG=latest
F1_TAG=latest
NBA_TAG=latest
NFL_TAG=latest
CFB_TAG=latest
SPORTS_TAG=latest
TRADEHUB_TAG=latest

# ── Predictor secrets (same values as the Azure container app secrets) ───
ODDS_API_KEY=
SPORTSBOOK_API_KEY=
CFBD_API_KEY=
# PL's public "refresh" button dispatches its GitHub Action with this token.
PL_GITHUB_ACTIONS_TOKEN=

# ── Trade hub (only once the tradehub profile is enabled) ────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Trade hub sports edges (rollout step 7b) ─────────────────────────────
# Internal compose-network URLs for the predictor APIs; public site links.
SPORTS_NFL_BASE_URL=http://nfl:8001
SPORTS_CFB_BASE_URL=http://cfb:8003
SPORTS_NFL_SITE_URL=https://sports.example.com
SPORTS_CFB_SITE_URL=https://sports.example.com
# Optional: OpenRouter key for the free-model edge reviewer.
OPENROUTER_API_KEY=
