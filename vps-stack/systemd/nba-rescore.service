[Unit]
Description=NBA predictor: refresh data, retrain and re-score upcoming games
After=docker.service nba-db-backup.service
Requires=docker.service nba-db-backup.service
# A catch-up run after downtime (Persistent=true on both timers) must still copy the DB first, and must NOT run
# if that copy or the live DB's integrity check fails: rescoring a damaged DB is what lost the data on 2026-10-26.
# systemctl --failed shows the blocked job.

[Service]
Type=oneshot
User=deploy
# The tracking DB lives only in this container, and the daily CI refresh runs with --skip-predictions, so nothing else
# ever re-scores upcoming games: the picks fans saw on 2026-10-20 were two weeks old. Ingest + the odds-derived markets pass.
ExecStart=/usr/bin/docker exec -w /app stack-nba-1 python -u -m nba_predictor.pipeline.refresh_full
TimeoutStartSec=90min
