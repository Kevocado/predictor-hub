[Unit]
Description=NBA predictor: refresh data, retrain and re-score upcoming games
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
# The tracking DB lives only in this container, and the daily CI refresh runs with --skip-predictions, so nothing else
# ever re-scores upcoming games: the picks fans saw on 2026-10-20 were two weeks old. Same pipeline as POST /admin/refresh-full.
ExecStart=/usr/bin/docker exec -w /app stack-nba-1 python -u -m nba_predictor.pipeline.ingest
TimeoutStartSec=90min
